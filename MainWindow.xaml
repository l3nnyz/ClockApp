<Window x:Class="ClockApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:m="clr-namespace:ClockApp"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=m:MainViewModel}"
        Title="Horloge mondiale"
        Width="1120" Height="800" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource TextFont}">

    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <!-- Onglets façon « pivot » Windows 11 : texte + soulignement accentué -->
        <Style x:Key="PivotTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TabPanel IsItemsHost="True" Margin="0,0,0,18" />
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Header = texte, Tag = glyphe de l'icône. Le contenu de l'onglet hérite de Foreground. -->
        <Style x:Key="PivotTab" TargetType="TabItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=TabItem}}"
                                       FontFamily="{StaticResource IconFont}" FontSize="14" FontWeight="Normal"
                                       VerticalAlignment="Center" Margin="0,1,8,0" />
                            <TextBlock Text="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Background="Transparent" Margin="0,0,28,0" Padding="0,4,0,0">
                            <StackPanel>
                                <ContentPresenter x:Name="Header" ContentSource="Header"
                                                  TextElement.FontSize="15"
                                                  Opacity="0.7" />
                                <Rectangle x:Name="Underline" Height="3" Width="20" RadiusX="1.5" RadiusY="1.5"
                                           Margin="0,6,0,0" Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                           Visibility="Hidden" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Header" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Header" Property="Opacity" Value="1" />
                                <Setter TargetName="Header" Property="TextElement.FontWeight" Value="SemiBold" />
                                <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Interrupteur on/off (CheckBox restylée) -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="16,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" BorderThickness="1"
                                Background="Transparent" BorderBrush="{DynamicResource TextFillColorSecondaryBrush}">
                            <Ellipse x:Name="Knob" Width="12" Height="12" HorizontalAlignment="Left" Margin="3,0,0,0"
                                     Fill="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Knob" Property="Width" Value="14" />
                                <Setter TargetName="Knob" Property="Height" Value="14" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingCard" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Width" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>

        <Style x:Key="SettingDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SubsectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,20,0,8" />
        </Style>
    </Window.Resources>

    <Grid Margin="32,20,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE917;" FontFamily="{StaticResource IconFont}" FontSize="22"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                           VerticalAlignment="Center" Margin="0,2,12,0" />
                <TextBlock Text="Horloge mondiale" FontFamily="{StaticResource DisplayFont}"
                           FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Click="Sync_Click" Padding="12,6" ToolTip="{Binding StatusText}"
                        IsEnabled="{Binding CanSync}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,1,8,0" />
                        <TextBlock Text="Synchroniser l'heure" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1" Style="{StaticResource PivotTabControl}"
                    ItemContainerStyle="{StaticResource PivotTab}">
        <TabItem Header="Horloge" Tag="&#xE917;">
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="32,28"
                DataContext="{Binding}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Viewbox Width="230" Height="230" Margin="0,0,40,0">
                    <Canvas Width="200" Height="200">
                        <Ellipse Width="200" Height="200" Fill="{DynamicResource SubtleFillColorSecondaryBrush}"
                                 Stroke="{DynamicResource CardStrokeColorDefaultBrush}" StrokeThickness="1" />
                        <Canvas x:Name="DialTicks" />

                        <Line X1="100" Y1="112" X2="100" Y2="52" StrokeThickness="7"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stroke="{DynamicResource TextFillColorPrimaryBrush}">
                            <Line.RenderTransform>
                                <RotateTransform CenterX="100" CenterY="100" Angle="{Binding HourAngle}" />
                            </Line.RenderTransform>
                        </Line>
                        <Line X1="100" Y1="114" X2="100" Y2="26" StrokeThickness="4.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stroke="{DynamicResource TextFillColorPrimaryBrush}">
                            <Line.RenderTransform>
                                <RotateTransform CenterX="100" CenterY="100" Angle="{Binding MinuteAngle}" />
                            </Line.RenderTransform>
                        </Line>
                        <Line X1="100" Y1="122" X2="100" Y2="18" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stroke="{DynamicResource AccentFillColorDefaultBrush}">
                            <Line.RenderTransform>
                                <RotateTransform CenterX="100" CenterY="100" Angle="{Binding SecondAngle}" />
                            </Line.RenderTransform>
                        </Line>
                        <Ellipse Canvas.Left="94" Canvas.Top="94" Width="12" Height="12"
                                 Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                        <Ellipse Canvas.Left="97.5" Canvas.Top="97.5" Width="5" Height="5"
                                 Fill="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                    </Canvas>
                </Viewbox>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" DataContext="{Binding Selected}">
                    <TextBlock FontSize="15" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="{Binding Country, Mode=OneWay}" />
                        <Run Text="·" />
                        <Run Text="{Binding UtcText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding City}" FontFamily="{StaticResource DisplayFont}"
                               FontSize="34" FontWeight="SemiBold" Margin="0,2,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="-4,0,0,0">
                        <TextBlock Text="{Binding TimeText}" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="104" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SecondsText}" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="40" FontWeight="SemiBold" Margin="10,0,0,22" VerticalAlignment="Bottom"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </StackPanel>

                    <TextBlock Text="{Binding DateText}" FontSize="18" Margin="0,-6,0,4" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="&#xE706;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,1,8,0" Foreground="#FFB900" />
                        <TextBlock FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run Text="{Binding SunText, Mode=OneWay}" />
                            <Run Text="·" />
                            <Run Text="{Binding DayLengthText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,1,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSynced}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding SourceText}" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="  ·  " FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding RelativeText}" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,28,0,12">
            <TextBlock Text="Vos villes" FontFamily="{StaticResource DisplayFont}" FontSize="20"
                       FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Grid Width="260" VerticalAlignment="Center">
                    <ComboBox x:Name="CityPicker" ItemsSource="{Binding Catalog}" SelectedItem="{Binding CityToAdd}"
                              DisplayMemberPath="Display" />
                    <TextBlock Text="Choisir une ville…" Margin="12,0,0,1" VerticalAlignment="Center"
                               IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedItem, ElementName=CityPicker}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Button Click="AddCity_Click" Margin="8,0,0,0" Padding="14,6" VerticalAlignment="Center"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                        Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,1,8,0" />
                        <TextBlock Text="Ajouter" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="CardsScroller" Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,-16,0" Padding="0,0,16,0"
                      AllowDrop="True" PreviewDragOver="CardsScroller_PreviewDragOver">
            <ItemsControl ItemsSource="{Binding Cities}" Margin="0,0,0,24">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type m:CityClock}">
                        <Border x:Name="Card" Width="250" Margin="0,0,12,12" Padding="20,16,12,18"
                                Cursor="Hand" AllowDrop="True" ToolTip="Glisser pour réorganiser" ToolTipService.InitialShowDelay="1500"
                                MouseLeftButtonDown="CityCard_MouseDown" MouseMove="CityCard_MouseMove"
                                MouseLeftButtonUp="CityCard_Click" DragOver="CityCard_DragOver" Drop="CityCard_Drop">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="DayIcon" Text="&#xE706;" FontFamily="{StaticResource IconFont}"
                                                   FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"
                                                   Foreground="#FFB900" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding City}" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Country}" FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                                            VerticalAlignment="Top" FontSize="10" Padding="7" Margin="0,-6,0,0"
                                            Content="&#xE711;" ToolTip="Retirer" Click="RemoveCity_Click" />
                                </Grid>

                                <TextBlock Grid.Row="1" Text="{Binding TimeText}" FontFamily="{StaticResource DisplayFont}"
                                           FontSize="46" FontWeight="SemiBold" Margin="-2,8,0,0" />

                                <StackPanel Grid.Row="2">
                                    <TextBlock Text="{Binding RelativeText}" FontSize="13" />
                                    <TextBlock Text="{Binding DateText}" FontSize="12" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding SunText}" FontSize="12" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <StackPanel x:Name="ClockChangeLine" Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="&#xE823;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                   VerticalAlignment="Top" Margin="0,2,6,0"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{Binding ClockChangeText}" FontSize="12" TextWrapping="Wrap" MaxWidth="196"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsDay}" Value="False">
                                <Setter TargetName="DayIcon" Property="Text" Value="&#xE708;" />
                                <Setter TargetName="DayIcon" Property="Foreground" Value="#8AB4F8" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Card" Property="Padding" Value="19,15,11,17" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                <Setter TargetName="Card" Property="Opacity" Value="0.4" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ClockChangeText}" Value="">
                                <Setter TargetName="ClockChangeLine" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        </Grid>
        </TabItem>

        <TabItem Header="Paramètres" Tag="&#xE713;">

            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-16,0" Padding="0,0,16,0">
                <StackPanel Margin="0,0,0,24"
                            DataContext="{Binding Settings}">

                    <TextBlock Text="Rappels" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />

                    <Border Style="{StaticResource SettingCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xEA8F;" Style="{StaticResource SettingIcon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Activer les rappels" FontSize="14" />
                                <TextBlock Style="{StaticResource SettingDescription}"
                                           Text="Une petite notification aux moments clés de la journée dans vos villes : quand les bureaux ouvrent, à midi, le soir…" />
                            </StackPanel>
                            <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding RemindersEnabled}" />
                        </Grid>
                    </Border>

                    <StackPanel IsEnabled="{Binding RemindersEnabled}">
                        <TextBlock Text="Quand vous prévenir" Style="{StaticResource SubsectionTitle}" />

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE706;" Style="{StaticResource SettingIcon}" Foreground="#FFB900" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Début de journée · 9 h" FontSize="14" />
                                    <TextBlock Style="{StaticResource SettingDescription}"
                                               Text="La ville se réveille : les bureaux et les boutiques ouvrent." />
                                </StackPanel>
                                <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding MorningReminder}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xEC32;" Style="{StaticResource SettingIcon}" Foreground="#F7630C" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Pause déjeuner · 12 h" FontSize="14" />
                                    <TextBlock Style="{StaticResource SettingDescription}"
                                               Text="C’est l’heure du déjeuner là-bas, en semaine comme le week-end." />
                                </StackPanel>
                                <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding LunchReminder}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE7E8;" Style="{StaticResource SettingIcon}" Foreground="#C239B3" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Fin de journée · 18 h" FontSize="14" />
                                    <TextBlock Style="{StaticResource SettingDescription}"
                                               Text="Les bureaux se vident et la soirée commence." />
                                </StackPanel>
                                <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding EveningReminder}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE708;" Style="{StaticResource SettingIcon}" Foreground="#8AB4F8" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Il se fait tard · 22 h" FontSize="14" />
                                    <TextBlock Style="{StaticResource SettingDescription}"
                                               Text="La soirée est avancée, la ville s’endort peu à peu." />
                                </StackPanel>
                                <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding NightReminder}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE823;" Style="{StaticResource SettingIcon}" Foreground="#4CC2FF" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Changements d’heure" FontSize="14" />
                                    <TextBlock Style="{StaticResource SettingDescription}"
                                               Text="Prévenir deux jours avant qu’une ville (ou vous) passe à l’heure d’été ou d’hiver, avec le nouvel écart." />
                                </StackPanel>
                                <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding ClockChangeReminder}" />
                            </Grid>
                        </Border>

                        <TextBlock Text="Options" Style="{StaticResource SubsectionTitle}" />

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE708;" Style="{StaticResource SettingIcon}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Ne pas déranger la nuit" FontSize="14" />
                                    <TextBlock Style="{StaticResource SettingDescription}"
                                               Text="Aucun rappel entre 23 h et 7 h, heure de votre PC." />
                                </StackPanel>
                                <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding QuietHours}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE767;" Style="{StaticResource SettingIcon}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Son" FontSize="14" />
                                    <TextBlock Style="{StaticResource SettingDescription}"
                                               Text="Jouer le son de notification de Windows avec chaque rappel." />
                                </StackPanel>
                                <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding PlaySound}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE946;" Style="{StaticResource SettingIcon}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Aperçu" FontSize="14" />
                                    <TextBlock Style="{StaticResource SettingDescription}"
                                               Text="Les villes à la même heure que vous sont ignorées, et celles qui partagent la même heure sont regroupées en un seul rappel." />
                                </StackPanel>
                                <Button Grid.Column="2" Content="Tester un rappel" Padding="14,6"
                                        VerticalAlignment="Center" Click="TestReminder_Click" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="Apparence" Style="{StaticResource SectionTitle}" Margin="0,28,0,10" />

                    <Border Style="{StaticResource SettingCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE790;" Style="{StaticResource SettingIcon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Thème" FontSize="14" />
                                <TextBlock Style="{StaticResource SettingDescription}"
                                           Text="Suivre le thème de Windows, ou forcer le mode clair ou sombre." />
                            </StackPanel>
                            <ComboBox Grid.Column="2" Width="160" VerticalAlignment="Center"
                                      SelectedValuePath="Tag" SelectedValue="{Binding Theme}">
                                <ComboBoxItem Content="Système" Tag="{x:Static m:AppTheme.System}" />
                                <ComboBoxItem Content="Clair" Tag="{x:Static m:AppTheme.Light}" />
                                <ComboBoxItem Content="Sombre" Tag="{x:Static m:AppTheme.Dark}" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <TextBlock Text="Application" Style="{StaticResource SectionTitle}" Margin="0,28,0,10" />

                    <Border Style="{StaticResource SettingCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE7E8;" Style="{StaticResource SettingIcon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Lancer au démarrage de Windows" FontSize="14" />
                                <TextBlock Style="{StaticResource SettingDescription}"
                                           Text="L'horloge démarre discrètement dans la zone de notification, prête pour vos rappels." />
                            </StackPanel>
                            <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE8A7;" Style="{StaticResource SettingIcon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Garder dans la zone de notification" FontSize="14" />
                                <TextBlock Style="{StaticResource SettingDescription}"
                                           Text="Fermer la fenêtre la range près de l'heure de Windows au lieu de quitter. Clic droit sur l'icône pour quitter." />
                            </StackPanel>
                            <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding CloseToTray}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        </TabControl>
    </Grid>
</Window>
